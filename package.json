{
  "name": "faster-npm-meta-server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev src/entrypoints/worker.ts",
    "build": "rollup -c rollup.config.ts --configPlugin swc3",
    "build:worker": "BUILD_TARGET=worker pnpm build",
    "build:snippet": "BUILD_TARGET=snippet pnpm build",
    "build:fetcher": "BUILD_TARGET=fetcher pnpm build",
    "build:analyze": "ANALYZE=true pnpm build",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:fetcher": "pnpm build:fetcher && wrangler deploy -c wrangler.fetcher.toml",
    "lint": "eslint --format=sukka .",
    "test": "SWC_NODE_IGNORE_DYNAMIC=1 SWC_NODE_INLINE_SOURCE_MAP=1 mocha --require @swc-node/register --parallel --full-trace \"./src/**/*.test.ts\" \"./test/**/*.test.ts\"",
    "test:live": "SWC_NODE_IGNORE_DYNAMIC=1 SWC_NODE_INLINE_SOURCE_MAP=1 LIVE_PARITY=1 mocha --require @swc-node/register --full-trace ./test/upstream-parity.live.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors-edge": "^1.0.6",
    "flru": "^1.0.2",
    "foxts": "^5.9.1",
    "lemmih": "^0.0.4",
    "ufo": "^1.6.4",
    "validate-npm-package-name": "^8.0.0",
    "verkit": "^0.3.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@eslint-sukka/node": "^9.0.1",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/npm-package-arg": "^6.1.4",
    "@types/sinon": "^22.0.0",
    "@types/validate-npm-package-name": "^4.0.2",
    "earl": "^2.0.0",
    "eslint": "^10.9.1",
    "eslint-config-sukka": "^9.0.1",
    "eslint-formatter-sukka": "^9.0.1",
    "fast-npm-meta": "^2.2.0",
    "miniflare": "^4.20260730.0",
    "mocha": "^11.8.0",
    "npm-package-arg": "^14.0.0",
    "rollup": "^4.63.1",
    "rollup-plugin-oxc-resolve": "^0.0.5",
    "rollup-plugin-swc3": "^0.12.1",
    "sinon": "^22.1.0",
    "typescript": "^6.0.3",
    "vite-bundle-analyzer": "^1.3.9",
    "wrangler": "^4.127.1",
    "xbits": "^0.2.0"
  },
  "packageManager": "pnpm@11.24.0"
}
